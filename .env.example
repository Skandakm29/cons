# ---------------------------------------------------------------------------
# Database
# Local: `docker compose up -d` or `npm run db:local` (both on port 5433).
# Vercel + Neon: the Neon integration sets both variables automatically
# (DATABASE_URL = pooled, DATABASE_URL_UNPOOLED = direct, used for migrations).
DATABASE_URL="postgresql://buildbid:buildbid@localhost:5433/buildbid?schema=public"
DATABASE_URL_UNPOOLED="postgresql://buildbid:buildbid@localhost:5433/buildbid?schema=public"

# ---------------------------------------------------------------------------
# NextAuth — NEXTAUTH_URL is your site's public URL.
# Generate the secret with: openssl rand -base64 32  (use a different one in production)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# ---------------------------------------------------------------------------
# OTP login
# OTP_PROVIDER: "mock" (local dev: prints the code; 123456 always works),
#               "twilio" (Twilio Verify) or "msg91".
OTP_PROVIDER="mock"
# Numbers that may log in with 123456 even in production (comma-separated, 10 digits).
# For your own testing / app-store reviewers only. Leave empty to disable.
OTP_TEST_NUMBERS=""
# Twilio Verify (OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
# MSG91 Flow API (OTP_PROVIDER=msg91) — needs a DLT-approved template with an OTP variable
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_OTP_VAR="otp"

# ---------------------------------------------------------------------------
# File uploads
# STORAGE_PROVIDER: "local" (writes to public/uploads) or "vercel-blob".
STORAGE_PROVIDER="local"
# Set automatically by Vercel when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=""
