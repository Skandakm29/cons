# Postgres (docker compose up, or `npm run db:local` without Docker)
DATABASE_URL="postgresql://buildbid:buildbid@localhost:5433/buildbid?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# OTP provider: "mock" logs the code to the server console.
# In development the code 123456 is always accepted.
OTP_PROVIDER="mock"
# Future: MSG91_AUTH_KEY=, MSG91_TEMPLATE_ID=, TWILIO_ACCOUNT_SID=, TWILIO_AUTH_TOKEN=, TWILIO_VERIFY_SID=

# Storage provider: "local" writes to /public/uploads.
STORAGE_PROVIDER="local"
# Future: S3_BUCKET=, S3_REGION=, AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=, CLOUDINARY_URL=
